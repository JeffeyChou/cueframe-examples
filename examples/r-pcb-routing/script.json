{
  "engine": "command",
  "command": "uv run --project ../../../index-tts python scripts/say.py {jobs}",
  "voice": "me",
  "align": {"model": "small", "language": "zh"},
  "lead": 0.6,
  "music": {"grid": "build/beats.json", "file": "build/stems/bed.wav"},
  "lines": [
    {"id": "r1", "at": "bar 1", "pad": 0.3, "say": "每一根走线，都从芯片的引脚出发，去找自己的路。"},
    {"id": "r2", "at": "bar 4 - 0.6", "pad": 0.3, "say": "路上全是焊盘和过孔，碰不得，只能四十五度拐弯，一路绕开。"},
    {"id": "r3", "land": {"text": "躲", "on": "bar 9"}, "pad": 0.6, "say": "一组信号要并排走，一起拐弯，一起躲。"},
    {"id": "s1", "land": {"text": "不止", "on": "bar 11"}, "pad": 0.4, "say": "可是镜头拉远，赶路的不止这一队。"},
    {"id": "s2", "land": {"text": "每一层", "on": "bar 12 beat 2"}, "pad": 0.3, "say": "同一时刻，每一层都有人在布线。"},
    {"id": "s3", "pad": 0.8, "say": "顶层、内层、电源层、地层，一共十层。"},
    {"id": "k1", "at": "bar 17 - 0.6", "pad": 0.2, "say": "把这十层叠起来，"},
    {"id": "k2", "pad": 1.2, "say": "每一层的线，都要和上下层对齐、打孔，互不打架。"},
    {"id": "k3", "at": "bar 22 beat 3 - 0.6", "pad": 2.6, "say": "十层，布完了。"}
  ]
}
